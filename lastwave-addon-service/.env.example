# Copy to .env and fill in. Never commit .env.
PORT=8787
BASE_URL=http://localhost:8787
SESSION_SECRET=change-me-to-a-long-random-string

# Upstream TIDAL-compatible backend (server-side only, never exposed to clients)
UPSTREAM_BASE_URL=https://tidal.kanjijewels.com
UPSTREAM_API_KEY=hifi_0cc8a0404432795b80649142196cc0b94246534ec08c3e9c

# Daily song quota per authenticated account (fixed requirement: 500)
DAILY_SONG_LIMIT=500

# Telegram bot (verification + channel-membership gate, from @BotFather)
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# Channel the user must join, e.g. @clashprojects or -1001234567890.
# The bot must be an admin of this channel (for getChatMember checks).
TELEGRAM_REQUIRED_CHANNEL=
# Invite link sent when the user hasn't joined (defaults to t.me/<channel>).
TELEGRAM_INVITE_URL=

# Discord Pure OAuth2 (Sign in with Discord + Auto-Join Server)
# Create app in https://discord.com/developers/applications -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/auth/discord/callback
# Your Discord Server ID (users will automatically join this server on sign-in)
DISCORD_GUILD_ID=
# Discord Bot Token (used purely by the backend REST API to add members to the server via guilds.join)
# Ensure your bot is in the server with "Create Instant Invite" permission
DISCORD_BOT_TOKEN=

# Admin panel password (used at /admin login)
ADMIN_TOKEN=change-me-admin-password

# GitHub star bonus (+50% daily quota while the user stars the repo).
# Create an OAuth App (no scopes needed) at GitHub -> Settings ->
# Developer settings -> OAuth Apps, with Authorization callback URL:
#   <BASE_URL>/auth/github/callback
# Then fill these in. Empty = star bonus disabled (rest works fine).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Bonus tasks (ALL required for +50%): comma-separated, defaults shown.
# GITHUB_STAR_REPOS=Clash-Projects/LastWave-Native,Clash-Projects/LastWave-Desktop
# GITHUB_FOLLOW_ACCOUNTS=ajisth69,Clash-Projects

# One-way client lock: ONLY your app can use these addon URLs.
# Long random string, embedded (obfuscated) in the APK and set here.
# Comma-separated list allowed ("old,new") so rotations overlap.
# Empty = lock OFF: URLs work in any compatible player (dev only).
ADDON_CLIENT_SECRET=

# Allow local testing without real Telegram/Discord credentials.
# Set to "true" ONLY for local dev. Never enable in production.
ALLOW_DEV_LOGIN=true
