<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- hsl(0, 5%, 6%): the same formula Md3SchemeBuilder uses for the md
         background token, evaluated at the default hue so the splash screen
         never flashes a mismatched color. -->
    <color name="splash_background">#FF100F0F</color>

    <!-- LastWave app icon (Aug 2026 restore): the lime circle behind the
         four bars in the official logo. Used as the adaptive icon's
         background layer, paired with ic_launcher_foreground for the bars. -->
    <color name="ic_launcher_background">#FF000000</color>
</resources>
