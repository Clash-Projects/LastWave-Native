<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="oval">
            <gradient
                android:angle="180"
                android:startColor="#FF67849F"
                android:endColor="#FF1A2C4F" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape
            android:shape="oval">
            <solid
                android:color="#22000000" />
            <stroke
                android:width="1dp"
                android:color="#30FFFFFF" />
        </shape>
    </item>
    <item
        android:width="19dp"
        android:height="19dp"
        android:gravity="center"
        android:drawable="@drawable/ic_wave_widget_music" />
</layer-list>
