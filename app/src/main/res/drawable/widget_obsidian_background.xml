<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted Obsidian Glass Card: translucent smoked glass with refractive specular rim -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="135"
        android:startColor="#D91B1F27"
        android:endColor="#F2101217"
        android:type="linear" />
    <stroke
        android:width="1.5dp"
        android:color="#4DFFFFFF" />
</shape>
