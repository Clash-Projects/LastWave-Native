<?xml version="1.0" encoding="utf-8"?>
<!-- Sized placeholder: the expanded widget's art view takes its width from the drawable's aspect ratio. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="128dp"
                android:height="128dp" />
            <corners android:radius="28dp" />
            <solid android:color="@color/widget_surface_variant" />
        </shape>
    </item>
    <item
        android:width="44dp"
        android:height="44dp"
        android:gravity="center"
        android:drawable="@drawable/ic_widget_logo_mark" />
</layer-list>
