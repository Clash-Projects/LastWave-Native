<?xml version="1.0" encoding="utf-8"?>
<!-- Premium card: soft diagonal sheen over the surface + a faint metallic
     hairline. Plain shape = inflates in every launcher process. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:angle="135"
        android:startColor="@color/widget_surface_top"
        android:endColor="@color/widget_surface"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_hairline" />
</shape>
