<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wave_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
    <FrameLayout
        android:id="@+id/wave_widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wave_widget_library_surface">
        <ImageView
            android:id="@+id/wave_surface_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/wave_widget_library_surface" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="7dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.38"
                android:layout_marginEnd="6dp"
                android:background="@drawable/wave_widget_library_panel"
                android:orientation="vertical"
                android:padding="6dp">
                <ImageView
                    android:id="@+id/wave_art"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/wave_widget_library_panel"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/wave_widget_preview_art" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/wave_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/google_sans_flex"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/wave_widget_preview_title"
                        android:textColor="#FFF6F4FF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <FrameLayout
                        android:id="@+id/wave_like"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/wave_widget_like">
                        <ImageView
                            android:id="@+id/wave_like_icon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wave_widget_favorite"
                            android:tint="#FFD8D6F6" />
                    </FrameLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/wave_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/google_sans_flex"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/wave_widget_preview_artist"
                    android:textColor="#FFC4C4DB"
                    android:textSize="10sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/wave_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/google_sans_flex"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/wave_widget_preview_time"
                    android:textColor="#FFC4C4DB"
                    android:textSize="10sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:id="@+id/wave_previous"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/desc_previous">
                        <ImageView
                            android:id="@+id/wave_previous_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_widget_skip_previous"
                            android:tint="#FFF6F4FF" />
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/wave_play"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/wave_widget_play">
                        <ImageView
                            android:id="@+id/wave_play_background"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/wave_widget_control_accent" />
                        <ImageView
                            android:id="@+id/wave_play_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_widget_play"
                            android:tint="#FF101225" />
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/wave_next"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/desc_next">
                        <ImageView
                            android:id="@+id/wave_next_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_widget_skip_next"
                            android:tint="#FFF6F4FF" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.62"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/wave_widget_library_panel"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans_flex"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/wave_widget_recently_played"
                        android:textColor="#FFF6F4FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:id="@+id/wave_recent_1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp">
                                <ImageView
                                    android:id="@+id/wave_recent_art_1"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/wave_widget_preview_recent_1" />
                                <TextView
                                    android:id="@+id/wave_recent_title_1"
                                    android:layout_width="match_parent"
                                    android:layout_height="12dp"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/google_sans_flex"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="@string/wave_widget_preview_next_one"
                                    android:textColor="#FFF6F4FF"
                                    android:textSize="9sp" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/wave_recent_2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp">
                                <ImageView
                                    android:id="@+id/wave_recent_art_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/wave_widget_preview_recent_2" />
                                <TextView
                                    android:id="@+id/wave_recent_title_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="12dp"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/google_sans_flex"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="@string/wave_widget_preview_next_two"
                                    android:textColor="#FFF6F4FF"
                                    android:textSize="9sp" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/wave_recent_3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp">
                                <ImageView
                                    android:id="@+id/wave_recent_art_3"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/wave_widget_preview_recent_3" />
                                <TextView
                                    android:id="@+id/wave_recent_title_3"
                                    android:layout_width="match_parent"
                                    android:layout_height="12dp"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/google_sans_flex"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="@string/wave_widget_preview_next_three"
                                    android:textColor="#FFF6F4FF"
                                    android:textSize="9sp" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/wave_recent_4"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp">
                                <ImageView
                                    android:id="@+id/wave_recent_art_4"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/wave_widget_preview_recent_4" />
                                <TextView
                                    android:id="@+id/wave_recent_title_4"
                                    android:layout_width="match_parent"
                                    android:layout_height="12dp"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/google_sans_flex"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="@string/wave_widget_preview_playlist_four"
                                    android:textColor="#FFF6F4FF"
                                    android:textSize="9sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/wave_recent_empty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/google_sans_flex"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/wave_widget_no_recent"
                            android:textColor="#FFC4C4DB"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/wave_widget_library_panel"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/google_sans_flex"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/wave_widget_quick_access"
                            android:textColor="#FFF6F4FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/wave_logo"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_widget_logo_mark"
                            android:tint="#FFC4C4DB" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="5dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <FrameLayout
                            android:id="@+id/wave_search"
                            android:layout_width="29dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/wave_widget_glass_button"
                            android:contentDescription="@string/wave_widget_search">
                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_search"
                                android:tint="#FFF6F4FF" />
                        </FrameLayout>
                        <LinearLayout
                            android:id="@+id/wave_playlist_shortcut"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/wave_widget_glass_button"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="5dp">
                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:layout_marginEnd="5dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_wave_widget_music"
                                android:tint="#FFF6F4FF" />
                            <TextView
                                android:id="@+id/wave_playlist_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/google_sans_flex"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/wave_widget_playlist_shortcut"
                                android:textColor="#FFF6F4FF"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
