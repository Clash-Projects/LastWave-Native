<?xml version="1.0" encoding="utf-8"?>
<!-- Large now-playing widget. Same rules as the small one: framework views
     only, empty + content in a single file, real initialLayout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_empty_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_name"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_description"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Player state -->
    <LinearLayout
        android:id="@+id/widget_content_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="Unknown track"
            android:textColor="@color/widget_on_surface"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Unknown artist"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="Paused"
                android:textAllCaps="true"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Champagne rule: the quiet luxury signature. -->
        <View
            android:layout_width="32dp"
            android:layout_height="2dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/widget_accent_bar" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_circle"
                android:contentDescription="@string/desc_previous"
                android:padding="12dp"
                android:src="@drawable/ic_widget_skip_previous" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="72dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_play_pill"
                android:contentDescription="@string/desc_play_pause"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_circle"
                android:contentDescription="@string/desc_next"
                android:padding="12dp"
                android:src="@drawable/ic_widget_skip_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
