<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wave_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">
    <FrameLayout
        android:id="@+id/wave_widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wave_widget_library_surface">
        <ImageView
            android:id="@+id/wave_surface_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/wave_widget_library_surface" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/wave_widget_library_panel"
                android:orientation="vertical"
                android:padding="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/wave_art"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="0.42"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/wave_widget_preview_art" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.58"
                        android:gravity="center_vertical"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/wave_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/google_sans_flex"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/wave_widget_preview_title"
                            android:textColor="#FFF6F4FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/wave_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/google_sans_flex"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/wave_widget_preview_artist"
                            android:textColor="#FFC4C4DB"
                            android:textSize="10sp"
                            android:visibility="gone" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/wave_time"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/google_sans_flex"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/wave_widget_preview_time"
                                android:textColor="#FFC4C4DB"
                                android:textSize="9sp" />
                            <FrameLayout
                                android:id="@+id/wave_like"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@string/wave_widget_like">
                                <ImageView
                                    android:id="@+id/wave_like_icon"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_wave_widget_favorite"
                                    android:tint="#FFD8D6F6" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:id="@+id/wave_previous"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/desc_previous">
                        <ImageView
                            android:id="@+id/wave_previous_icon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_widget_skip_previous"
                            android:tint="#FFF6F4FF" />
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/wave_play"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/wave_widget_play">
                        <ImageView
                            android:id="@+id/wave_play_background"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/wave_widget_control_accent" />
                        <ImageView
                            android:id="@+id/wave_play_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_widget_play"
                            android:tint="#FF101225" />
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/wave_next"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/desc_next">
                        <ImageView
                            android:id="@+id/wave_next_icon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_widget_skip_next"
                            android:tint="#FFF6F4FF" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/wave_widget_library_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">
                <FrameLayout
                    android:id="@+id/wave_search"
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/wave_widget_glass_button"
                    android:contentDescription="@string/wave_widget_search">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        android:tint="#FFF6F4FF" />
                </FrameLayout>
                <LinearLayout
                    android:id="@+id/wave_playlist_shortcut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/wave_widget_glass_button"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingEnd="3dp">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wave_widget_music"
                        android:tint="#FFF6F4FF" />
                    <TextView
                        android:id="@+id/wave_playlist_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/google_sans_flex"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/wave_widget_playlist_shortcut"
                        android:textColor="#FFF6F4FF"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
