<?xml version="1.0" encoding="utf-8"?>
<!-- Compact single-row variant, picked when the placed widget is short
     (1-row launchers, narrow/resized widgets). Total height is 60dp
     (44dp art + 8dp padding top/bottom) so it always fits without
     clipping. Same view IDs as widget_now_playing.xml — one binder
     drives both, nothing can mismatch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Empty state: no session or no notification access -->
    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_empty_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_name"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_description"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Player state: art + flexible text + fixed control cluster.
         Text column is 0dp/weight=1 so it only ever shrinks — buttons can
         never be pushed out or overlapped, even at minResizeWidth. -->
    <LinearLayout
        android:id="@+id/widget_content_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Unknown track"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Unknown artist"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:text="Paused"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_circle"
            android:contentDescription="@string/desc_previous"
            android:padding="8dp"
            android:src="@drawable/ic_widget_skip_previous" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="44dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_play_pill"
            android:contentDescription="@string/desc_play_pause"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_circle"
            android:contentDescription="@string/desc_next"
            android:padding="8dp"
            android:src="@drawable/ic_widget_skip_next" />
    </LinearLayout>
</LinearLayout>
