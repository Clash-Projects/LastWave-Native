<?xml version="1.0" encoding="utf-8"?>
<!-- Square / tall now-playing widget (2x2, 3x2): art + title/artist row, play pill + next below.
     No vertical padding: the wrap_content groups are centred, so the space above and below is always equal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ref_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="14dp">

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_empty_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_art_placeholder" />

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 650, 'opsz' 16"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_name"
            android:textColor="@color/widget_on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_empty_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 450, 'opsz' 13"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_description"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Active playback state -->
    <LinearLayout
        android:id="@+id/widget_content_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_art_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Fixed height so autosize shrinks long titles to fit one line instead of ellipsizing. -->
                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="21dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 650, 'opsz' 16"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Unknown track"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical">

                    <!-- EQ leads so a long artist name can't push it out of view. -->
                    <ImageView
                        android:id="@+id/widget_eq_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_eq_frame_0" />

                    <TextView
                        android:id="@+id/widget_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/google_sans_flex"
                        android:fontVariationSettings="'wght' 450, 'opsz' 13"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Unknown artist"
                        android:textColor="@color/widget_on_surface"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/widget_play_pause_container"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/widget_ref_pill"
                android:gravity="center">

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/desc_play_pause"
                    android:src="@drawable/ic_widget_play"
                    android:tint="@color/widget_on_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_next_container"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_ref_circle"
                android:gravity="center">

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/desc_next"
                    android:src="@drawable/ic_widget_skip_next"
                    android:tint="@color/widget_on_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
