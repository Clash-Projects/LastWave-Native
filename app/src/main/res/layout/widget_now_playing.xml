<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ref_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_empty_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_art_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_name"
                android:textColor="@color/widget_on_surface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_description"
                android:textColor="@color/widget_on_surface"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active state -->
    <LinearLayout
        android:id="@+id/widget_content_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_art_placeholder" />

        <!-- Title, Artist and Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Unknown track"
                android:textColor="@color/widget_on_surface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Unknown artist"
                android:textColor="@color/widget_on_surface"
                android:textSize="13.5sp" />
                
            <!-- Hide these unnecessary views to keep WidgetViews.kt happy without throwing null pointer -->
            <LinearLayout
                android:id="@+id/widget_eq_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_eq_icon"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
                <ProgressBar
                    android:id="@+id/widget_progress"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
                <LinearLayout
                    android:id="@+id/widget_progress_row"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
                <ImageButton
                    android:id="@+id/widget_prev"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>

            <!-- Expressive Pills Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:orientation="horizontal">

                <!-- Play/Pause Pill -->
                <LinearLayout
                    android:id="@+id/widget_play_pause_container"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/widget_ref_pill"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/widget_play_pause"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_widget_play"
                        android:tint="@color/widget_on_primary" />

                    <TextView
                        android:id="@+id/widget_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Play"
                        android:textColor="@color/widget_on_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Next Pill -->
                <LinearLayout
                    android:id="@+id/widget_next_container"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/widget_ref_circle"
                    android:gravity="center"
                    android:orientation="horizontal">
                    
                    <ImageView
                        android:id="@+id/widget_next"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_widget_skip_next"
                        android:tint="@color/widget_on_primary" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
