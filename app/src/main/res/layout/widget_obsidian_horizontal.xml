<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_obsidian_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_empty_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_art_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex"
                android:maxLines="1"
                android:text="@string/widget_obsidian_name"
                android:textColor="@color/widget_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex"
                android:maxLines="1"
                android:text="@string/widget_obsidian_description"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active player state -->
    <LinearLayout
        android:id="@+id/widget_content_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_art_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex"
                android:maxLines="1"
                android:text="Unknown track"
                android:textColor="@color/widget_on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex"
                android:maxLines="1"
                android:text="Unknown artist"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Play/Pause Pill -->
                <LinearLayout
                    android:id="@+id/widget_play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/widget_obsidian_play"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:id="@+id/widget_play_pause_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_widget_play"
                        android:tint="@color/widget_icon_tint" />

                    <TextView
                        android:id="@+id/widget_play_pause_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/google_sans_flex"
                        android:text="Play"
                        android:textColor="@color/widget_on_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Next Button -->
                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/widget_obsidian_button"
                    android:contentDescription="@string/desc_next"
                    android:padding="6dp"
                    android:src="@drawable/ic_widget_skip_next"
                    android:tint="@color/widget_icon_tint" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
