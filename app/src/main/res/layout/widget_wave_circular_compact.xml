<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wave_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">
    <ImageView
        android:id="@+id/wave_surface_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/wave_widget_circular_surface"
        android:contentDescription="@null" />
    <LinearLayout
        android:id="@+id/wave_circle_labels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="52dp"
        android:paddingEnd="18dp"
        android:paddingBottom="27dp"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal">
        <TextView
            android:id="@+id/wave_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_flex"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/wave_widget_preview_title"
            android:textColor="#F6F4FF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wave_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_flex"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/wave_widget_preview_artist"
            android:textColor="#D8D4E6"
            android:textSize="10sp" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/wave_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/wave_widget_circle_play"
        android:contentDescription="@string/wave_widget_play">
        <ImageView
            android:id="@+id/wave_play_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/wave_play_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_play"
            android:tint="#F6F4FF"
            android:contentDescription="@null" />
    </FrameLayout>
    <LinearLayout
        android:id="@+id/wave_circle_navigation"
        android:layout_width="58dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="2dp"
        android:orientation="horizontal"
        android:background="@drawable/wave_widget_circle_navigation">
        <FrameLayout
            android:id="@+id/wave_previous"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/desc_previous">
            <ImageView
                android:id="@+id/wave_previous_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_skip_previous"
                android:tint="#F6F4FF"
                android:contentDescription="@null" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/wave_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/desc_next">
            <ImageView
                android:id="@+id/wave_next_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_skip_next"
                android:tint="#F6F4FF"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
