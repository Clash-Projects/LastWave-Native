<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wave_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:padding="0dp">
    <ImageView
        android:id="@+id/wave_surface_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wave_widget_strip_surface"
        android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/wave_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/wave_widget_strip_art"
            android:contentDescription="@null" />
        <LinearLayout
            android:id="@+id/wave_strip_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.36">
                <TextView
                    android:id="@+id/wave_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="14dp"
                    android:paddingEnd="20dp"
                    android:gravity="center_vertical"
                    android:fontFamily="@font/google_sans_flex"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/wave_widget_preview_title"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </FrameLayout>
            <LinearLayout
                android:id="@+id/wave_controls"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.64"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:id="@+id/wave_like"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/wave_widget_like">
                    <ImageView
                        android:id="@+id/wave_like_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_wave_widget_favorite"
                        android:tint="#FFFFFFFF"
                        android:contentDescription="@null" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/wave_previous"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/desc_previous">
                    <ImageView
                        android:id="@+id/wave_previous_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_wave_strip_previous"
                        android:tint="#FFFFFFFF"
                        android:contentDescription="@null" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/wave_play"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/wave_widget_play">
                    <ImageView
                        android:id="@+id/wave_play_background"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/wave_widget_control_accent"
                        android:contentDescription="@null" />
                    <ImageView
                        android:id="@+id/wave_play_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_wave_strip_play"
                        android:tint="#FFFFFFFF"
                        android:contentDescription="@null" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/wave_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/desc_next">
                    <ImageView
                        android:id="@+id/wave_next_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_wave_strip_next"
                        android:tint="#FFFFFFFF"
                        android:contentDescription="@null" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/wave_shuffle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/wave_widget_shuffle">
                    <ImageView
                        android:id="@+id/wave_shuffle_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_widget_shuffle"
                        android:tint="#FFFFFFFF"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/wave_logo"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:src="@drawable/ic_widget_logo_mark"
        android:tint="#FFFFFFFF"
        android:contentDescription="@string/app_name" />
</FrameLayout>
