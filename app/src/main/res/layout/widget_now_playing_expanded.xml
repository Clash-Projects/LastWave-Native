<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded now-playing widget (4x2 and larger): square art filling the height, title, artist, play pill + next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ref_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_empty_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_art_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 650"
                android:maxLines="1"
                android:text="@string/widget_name"
                android:textColor="@color/widget_on_surface"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex"
                android:maxLines="1"
                android:text="@string/widget_description"
                android:textColor="@color/widget_on_surface"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active playback state -->
    <LinearLayout
        android:id="@+id/widget_content_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Square art: height fills the card, width follows the (square) bitmap.
             maxWidth keeps room for the controls on tall, narrow slots. -->
        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:maxWidth="128dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_art_placeholder_large" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fixed height so the title can auto-size to the width on one line. -->
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 700"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Unknown track"
                android:textColor="@color/widget_on_surface"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 450"
                android:maxLines="1"
                android:text="Unknown artist"
                android:textColor="@color/widget_on_surface"
                android:textSize="13.5sp" />

            <LinearLayout
                android:id="@+id/widget_controls_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Play/Pause pill takes the spare width, so it never clips. -->
                <LinearLayout
                    android:id="@+id/widget_play_pause_container"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_ref_pill"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_play_pause"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/desc_play_pause"
                        android:src="@drawable/ic_widget_play"
                        android:tint="@color/widget_on_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_next_container"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/widget_ref_circle"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_next"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/desc_next"
                        android:src="@drawable/ic_widget_skip_next"
                        android:tint="@color/widget_on_primary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
